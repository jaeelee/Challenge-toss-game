{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-dom",
    "<THIRD_PARTY_MODULES>",
    "^/(App|main)",
    "^/pages",
    "^/widgets",
    "^/features",
    "^/entities",
    "^/shared",
    "^/assets",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
